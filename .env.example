# Frontend (Vite) — safe to expose in the browser, protected by RLS read-only policy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Scraper script only (scripts/scrape-initiatives.mjs) — NEVER expose these
# in the frontend/browser bundle. Keep this file out of git (see .gitignore).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override the two models the scraper pipeline uses (discovery,
# then an independent verification pass). Defaults live in
# scripts/lib/pipeline.mjs, only set these to experiment with other models.
# ANTHROPIC_DISCOVERY_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_VERIFY_MODEL=claude-sonnet-5
